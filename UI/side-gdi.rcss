/* Applies to every screen while GDI is the player's side. These repeat the defaults. */

/* The objectives screen's text. */
.line.fade
{
	color: #78d4b8;
	font-effect: outline(3dp #78d4b8);
}

.line.ink
{
	color: #20d460;
}
