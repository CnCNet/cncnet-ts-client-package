#reveal
{
	width: 314dp;
	height: 181dp;
	top: 50%;
	margin-top: -90.5dp;
}

.solo #reveal
{
	height: 228dp;
	margin-top: -114dp;
}

#content
{
	padding: 19dp 83dp 0 82dp;
}

.solo #content
{
	padding-left: 70dp;
	padding-right: 71dp;
}

button
{
	display: block;
	width: 149dp;
}

.solo button
{
	width: 173dp;
}

#load, #save, #abort
{
	margin-top: 5dp;
}

#resume
{
	margin-top: 6dp;
}

.solo #briefing, .solo #abort
{
	margin-top: 4dp;
}

.solo #load, .solo #delete, .solo #resume
{
	margin-top: 3dp;
}

.solo #save
{
	margin-top: 5dp;
}
